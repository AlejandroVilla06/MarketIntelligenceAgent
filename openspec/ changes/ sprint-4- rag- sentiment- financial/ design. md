@tool
def get_sentiment_price_correlation_tool(
    symbol: str,
    window_days: int = 30,
    start_date: str | None = None,
    end_date: str | None = None,
) -> str:
    """
    Compute statistical correlation between sentiment and stock price.
    ...
    """
    from src.agents.retriever import MarketRAGRetriever

    retriever = MarketRAGRetriever()

    # Determine date range
    end = end_date or date.today().isoformat()
    start = start_date or (end - window_days days).isoformat()

    # Layer 1: fetch from retriever
    sentiment_data = retriever.query_by_metadata(
        collection="sentiment", symbol=symbol, start_date=start, end_date=end
    )
    stock_data = retriever.query_by_metadata(
        collection="stocks", symbol=symbol, start_date=start, end_date=end
    )

    # Layer 2: validate overlap
    sentiment_dates = {m["date"] for r in sentiment_data for m in [r["metadata"]]}
    stock_dates = {m["date"] for r in stock_data for m in [r["metadata"]]}
    overlap = sentiment_dates & stock_dates

    if len(overlap) < 10:
        return json.dumps({
            "status": "insufficient_data",
            "overlap_count": len(overlap),
            "available_sentiment_range": [min(sentiment_dates), max(sentiment_dates)],
            "available_stock_range": [min(stock_dates), max(stock_dates)],
        })

    if not overlap:
        return json.dumps({
            "status": "no_overlap",
            "available_sentiment_range": [...],
            "available_stock_range": [...],
        })

    # Compute correlation via Polars
    df_sentiment = pl.DataFrame(...)
    df_stock = pl.DataFrame(...)
    df_aligned = df_sentiment.join(df_stock, on="date")
    pearson = float(df_aligned["sentiment_score"].corr(df_aligned["price_change_pct"]))
    spearman = float(spearmanr(...)[0])

    return json.dumps({
        "status": "success",
        "pearson_coefficient": round(pearson, 3),
        "spearman_coefficient": round(spearman, 3),
        "overlap_actual_days": len(overlap),
        "daily_breakdown": [...],
    })


